[91.868974, "o", "\u001b[2m  │ #!/usr/bin/env node\u001b[0m\r\n\u001b[2m  │ // Plain static server for dist/. No security headers — this is the vibe arm.\u001b[0m\r\n\u001b[2m  │ import http from 'node:http';\u001b[0m\r\n\u001b[2m  │ import fs from 'node:fs';\u001b[0m\r\n\u001b[2m  │ import path from 'node:path';\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ const args = process.argv.slice(2);\u001b[0m\r\n\u001b[2m  │ const i = args.indexOf('--port');\u001b[0m\r\n\u001b[2m  │ const PORT = Number(i >= 0 ? args[i + 1] : process.env.PORT ?? 4173);\u001b[0m\r\n\u001b[2m  │ const HOST = '127.0.0.1';\u001b[0m\r\n\u001b[2m  │ const DIST = path.resolve(import.meta.dirname, 'dist');\u001b[0m\r\n\u001b[2m  │ const MIME = {\u001b[0m\r\n\u001b[2m  │   '.html': 'text/html; charset=utf-8',\u001b[0m\r\n\u001b[2m  │   '.js': 'text/javascript; charset=utf-8',\u001b[0m\r\n\u001b[2m  │   '.mjs': 'text/javascript; charset=utf-8',\u001b[0m\r\n\u001b[2m  │   '.css': 'text/css; charset=utf-8',\u001b[0m\r\n\u001b[2m  │   '.json': 'application/json; charset=utf-8',\u001b[0m\r\n\u001b[2m  │   '.svg': 'image/svg+xml',\u001b[0m\r\n\u001b[2m  │   '.png': 'image/png',\u001b[0m\r\n\u001b[2m  │   '.ico': 'image/x-icon',\u001b[0m\r\n\u001b[2m  │   '.woff2': 'font/woff2',\u001b[0m\r\n\u001b[2m  │ };\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ http\u001b[0m\r\n\u001b[2m  │   .createServer((req, res) => {\u001b[0m\r\n\u001b[2m  │ … (11 more lines)\u001b[0m\r\n"]
