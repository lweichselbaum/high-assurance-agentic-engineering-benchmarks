[149.155893, "o", "\u001b[97mSmoke test passes. Now let's do a deeper functional check with Playwright to verify search, deep links, rich text rendering, and note\r\nselection actually work end-to-end.\u001b[0m\r\n"]
[161.17199, "o", "\u001b[35m▶ Bash\u001b[0m \u001b[97mcat > /tmp/verify.mjs << 'EOF'\r\nimport { spawn, spawnSync } from 'node:child_process';\r\nimport path from 'node:path';\r\nimport { chromium } from '@playwright/test';\r\n\r\nconst dir = process.cwd();\r\nconst port = 4700 + Math.floor(Math.random() * 200);\r\nconst server = spawn('node', [path.join(dir, 'server.mjs'), '--port', String(port)], { cwd: dir, stdio: 'inherit' });\r\nawait new Promise((r) => setTimeout(r, 500));\r\n\r\nconst browser = await chromium.launch();\r\nconst page = await browser.newPage();\r\npage.on('pageerror', (e) => console.log('pageerror:', e.message));\r\n\r\nconst base = `http://127.0.0.1:${port}/`;\r\n\r\n// 1. initial load, seeded notes, newest first\r\nawait page.goto(base, { waitUntil: 'load' });\r\nconst ids = await page.$$eval('#feed article.note', els => els.map(e => e.dataset.noteId));\r\nconsole.log('order:', ids);\r\n\r\n// check rich text rendering\r\nconst firstBodyHtml = await page.$eval('article.note[data-note-id=\"6\"] .note-body', el => el.innerHTML);\r\nconsole.log('note6 body html:', firstBodyHtml);\r\nconst linkHref = await page.$eval('article.note[data-note-id=\"4\"] .note-body a', el => el.getAttribute('href'));\r\nconsole.log('note4 link href:', linkHref);\r\nconst boldTag = await page.$eval('article.note[data-note-id=\"6\"] .note-body b', el => el.tagName);\r\nconsole.log('bold tag found:', boldTag);\r\n\r\n// 2. search\r\nawait page.fill('#search', 'douro');\r\nawait page.waitForTimeout(100);\r\nconst resultsLine = await page.$eval('#results-line', el => el.textContent);\r\nconsole.log('results-line:', JSON.stringify(resultsLine));\r\nconst filteredIds = await page.$$eval('#feed article.note', els => els.map(e => e.dataset.noteId));\r\nconsole.log('filtered ids:', filteredIds);\r\nconsole.log('hash after search:', await page.evaluate(() => location.hash));\r\n\r\n// 3. click a note title\r\nawait page.click('article.note[data-note-id=\"5\"] .note-title');\r\nawait page.waitForTimeout(100);\r\nconsole.log('hash after select:', await page.evaluate(() => location.hash));\r\nconst ariaCurrent = await page.$eval('article.note[data-note-id=\"5\"]', el => el.getAttribute('aria-current'));\r\nconsole.log('aria-current on 5:', ariaCurrent);\r\n\r\n// 4. reload and check restore\r\nawait page.reload({ waitUntil: 'load' });\r\nawait page.waitForTimeout(100);\r\nconsole.log('search value after reload:', await page.$eval('#search', el => el.value));\r\nconsole.log('results-line after reload:', await page.$eval('#results-line', el => el.textContent));\r\nconst ariaCurrent2 = await page.$eval('article.note[data-note-id=\"5\"]', el => el.getAttribute('aria-current'));\r\nconsole.log('aria-current on 5 after reload:', ariaCurrent2);\r\n\r\n// 5. add a new note with rich text\r\nawait page.fill('#search', '');\r\nawait page.waitForTimeout(50);\r\nawait page.fill('#title', 'Test Note');\r\nawait page.fill('#body', 'Hello <b>world</b>\\nsecond line <a href=\"https://example.com\">link</a>');\r\nawait page.fill('#avatar', '');\r\nawait page.click('#note-form button[type=submit]');\r\nawait page.waitForTimeout(100);\r\nconst newIds = await page.$$eval('#feed article.note', els => els.map(e => e.dataset.noteId));\r\nconsole.log('ids after add:', newIds);\r\nconst titleCleared = await page.$eval('#title', el => el.value);\r\nconsole.log('title cleared:', JSON.stringify(titleCleared));\r\nconst newBodyHtml = await page.$eval(`article.note[data-note-id=\"${Math.max(...newIds.map(Number))}\"] .note-body`, el => el.innerHTML);\r\nconsole.log('new note body html:', newBodyHtml);\r\n\r\n// 6. XSS check - malicious input\r\nawait page.fill('#title', 'XSS Test');\r\nawait page.fill('#body', '<img src=x onerror=alert(1)><script>alert(2)</script>');\r\nawait page.click('#note-form button[type=submit]');\r\nawait page.waitForTimeout(100);\r\nconst xssIds = await page.$$eval('#feed article.note', els => els.map(e => e.dataset.noteId));\r\nconst xssBodyHtml = await page.$eval(`article.note[data-note-id=\"${Math.max(...xssIds.map(Number))}\"] .note-body`, el => el.innerHTML);\r\nconsole.log('xss note body html:', xssBodyHtml);\r\n\r\n// 7. persistence across reload\r\nawait page.reload({ waitUntil: 'load' });\r\nawait page.waitForTimeout(100);\r\nconst per"]
[161.172272, "o", "sistedIds = await page.$$eval('#feed article.note', els => els.map(e => e.dataset.noteId));\r\nconsole.log('ids after reload (persisted):', persistedIds);\r\n\r\nawait browser.close();\r\nserver.kill();\r\nEOF\r\nnode /tmp/verify.mjs\u001b[0m\r\n"]
