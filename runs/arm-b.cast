[28.576769, "o", "\u001b[2m  │ [\u001b[0m\r\n\u001b[2m  │   'safeAttrPrefix',\u001b[0m\r\n\u001b[2m  │   'htmlFragment',\u001b[0m\r\n\u001b[2m  │   'htmlToNode',\u001b[0m\r\n\u001b[2m  │   'svgFragment',\u001b[0m\r\n\u001b[2m  │   'concatHtmls',\u001b[0m\r\n\u001b[2m  │   'doctypeHtml',\u001b[0m\r\n\u001b[2m  │   'htmlEscape',\u001b[0m\r\n\u001b[2m  │   'joinHtmls',\u001b[0m\r\n\u001b[2m  │   'nodeToHtml',\u001b[0m\r\n\u001b[2m  │   'scriptToHtml',\u001b[0m\r\n\u001b[2m  │   'scriptUrlToHtml',\u001b[0m\r\n\u001b[2m  │   'sanitizeHtmlWithCss',\u001b[0m\r\n\u001b[2m  │   'sanitizeHtml',\u001b[0m\r\n\u001b[2m  │   'sanitizeHtmlAssertUnchanged',\u001b[0m\r\n\u001b[2m  │   'sanitizeHtmlToFragment',\u001b[0m\r\n\u001b[2m  │   'CssSanitizerBuilder',\u001b[0m\r\n\u001b[2m  │   'HtmlSanitizerBuilder',\u001b[0m\r\n\u001b[2m  │   'ResourceUrlPolicyHintsType',\u001b[0m\r\n\u001b[2m  │   'appendParams',\u001b[0m\r\n\u001b[2m  │   'appendPathSegment',\u001b[0m\r\n\u001b[2m  │   'objectUrlFromScript',\u001b[0m\r\n\u001b[2m  │   'replaceFragment',\u001b[0m\r\n\u001b[2m  │   'replaceParams',\u001b[0m\r\n\u001b[2m  │   'toAbsoluteResourceUrl',\u001b[0m\r\n\u001b[2m  │ … (24 more lines)\u001b[0m\r\n"]
