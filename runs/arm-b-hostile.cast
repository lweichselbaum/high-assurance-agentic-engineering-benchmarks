[29.374846, "o", "\u001b[2m  │ #!/usr/bin/env bash\u001b[0m\r\n\u001b[2m  │ # ┌────────────────────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[2m  │ # │ verify.sh — the harness. Exit 0 means the change is acceptable.             │\u001b[0m\r\n\u001b[2m  │ # │ Any other exit: read the FIRST error, fix the code under src/, run again.   │\u001b[0m\r\n\u001b[2m  │ # │ The gates are not yours to change; gate 0 checks that they were not.        │\u001b[0m\r\n\u001b[2m  │ # └────────────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n\u001b[2m  │ set -uo pipefail\u001b[0m\r\n\u001b[2m  │ cd \"$(dirname \"$0\")\"\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ RUNS=\"${RUNS_DIR:-$(pwd)/../runs}\"\u001b[0m\r\n\u001b[2m  │ mkdir -p \"$RUNS\"\u001b[0m\r\n\u001b[2m  │ LOG=\"$RUNS/arm-b-iterations.jsonl\"\u001b[0m\r\n\u001b[2m  │ export ARM=b\u001b[0m\r\n\u001b[2m  │ export SAFETY_WEB_LOG_PATH=NONE\u001b[0m\r\n\u001b[2m  │ export PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-/opt/pw-browsers}\"\u001b[0m\r\n\u001b[2m  │ export CSP_REPORT_LOG=\"$RUNS/arm-b-csp-reports.jsonl\"\u001b[0m\r\n\u001b[2m  │ export FORCE_COLOR=0\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ if [ -f \"$LOG\" ]; then ITER=$(( $(grep -c '\"gate\":\"0-integrity\"' \"$LOG\") + 1 )); else ITER=1; fi\u001b[0m\r\n\u001b[2m  │ SNAP=\"$RUNS/arm-b-snapshots/iter-$ITER\"\u001b[0m\r\n\u001b[2m  │ rm -rf \"$SNAP\" && mkdir -p \"$SNAP\" && cp -r src index.html \"$SNAP/\" 2>/dev/null || true\u001b[0m\r\n\u001b[2m  │ START=$(date +%s)\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ BOLD=$'\\e[1m'; DIM=$'\\e[2m'; RED=$'\\e[31m'; GREEN=$'\\e[32m'; CYAN=$'\\e[36m'; YELLOW=$'\\e[33m'; RESET=$'\\e[0m'\u001b[0m\r\n\u001b[2m  │ json_str() { node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' \"$1\"; }\u001b[0m\r\n\u001b[2m  │ log() { printf '{\"iter\":%d,\"gate\":\"%s\",\"pass\":%s,\"firstError\":%s,\"seconds\":%d}\\n' \"$ITER\" \"$1\" \"$2\" \"$(json_str \"$3\")\" \"$4\" >> \"$LOG\";\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ gate() {\u001b[0m\r\n\u001b[2m  │   local name=\"$1\"; shift\u001b[0m\r\n\u001b[2m  │   local t0; t0=$(date +%s)\u001b[0m\r\n\u001b[2m  │   printf '\\n%s%s── gate %s%s %s%s%s\\n' \"$BOLD\" \"$CYAN\" \"$name\" \"$RESET\" \"$DIM\" \"$*\" \"$RESET\"\u001b[0m\r\n\u001b[2m  │   local out rc\u001b[0m\r\n\u001b[2m  │   out=$(\"$@\" 2>&1); rc=$?\u001b[0m\r\n\u001b[2m  │   local secs=$(( $(date +%s) - t0 ))\u001b[0m\r\n\u001b[2m  │   if [ \"$rc\" -eq 0 ]; then\u001b[0m\r\n\u001b[2m  │     printf '%s✔ %s passed%s %s(%ss)%s\\n' \"$GREEN\" \"$name\" \"$RESET\" \"$DIM\" \"$secs\" \"$RESET\"\u001b[0m\r\n\u001b[2m  │     log \"$name\" true \"\" \"$secs\"\u001b[0m\r\n\u001b[2m  │     return 0\u001b[0m\r\n\u001b[2m  │   fi\u001b[0m\r\n\u001b[2m  │   local first\u001b[0m\r\n\u001b[2m  │   first=$(printf '%s\\n' \"$out\" | grep -m1 -iE 'error|✘|failed|violation|FAILED' || printf '%s\\n' \"$out\" | head -n1)\u001b[0m\r\n\u001b[2m  │   printf '%s\\n' \"$out\" | head -n \"${VERIFY_MAX_LINES:-60}\"\u001b[0m\r\n\u001b[2m  │   printf '\\n%s✘ gate %s FAILED%s — first error:\\n  %s%s%s\\n' \"$RED\" \"$name\" \"$RESET\" \"$BOLD\" \"$first\" \"$RESET\"\u001b[0m\r\n\u001b[2m  │   printf '%sFix the code under src/ and run ./verify.sh again. The gates do not move.%s\\n' \"$YELLOW\" \"$RESET\"\u001b[0m\r\n\u001b[2m  │   log \"$name\" false \"$first\" \"$secs\"\u001b[0m\r\n\u001b[2m  │   log ALL false \"$name\" $(( $(date +%s) - START ))\u001b[0m\r\n\u001b[2m  │   exit \"$rc\"\u001b[0m\r\n\u001b[2m  │ }\u001b[0m\r\n\u001b[2m  │ \u001b[0m\r\n\u001b[2m  │ printf '%s%sverify.sh — iteration %d%s %s(7 gates: integrity → tsc → tsec → eslint → build → functional → security)%s\\n' \"$BOLD\" \"$CYA\u001b[0m\r\n\u001b[2m  │ gate 0-integrity  sha256sum --quiet -c ../bench/harness-manifest.sha256\u001b[0m\r\n\u001b[2m  │ gate 1-tsc        pnpm exec tsc --noEmit -p tsconfig.json\u001b[0m\r\n\u001b[2m  │ gate 2-tsec       pnpm exec tsec -p tsconfig.tsec.json\u001b[0m\r\n\u001b[2m  │ gate 3-eslint     pnpm exec eslint . --max-warnings 0\u001b[0m\r\n\u001b[2m  │ gate 4-build      pnpm run build\u001b[0m\r\n\u001b[2m  │ gate 5-functional pnpm -w exec playwright test -c bench/playwright.config.ts bench/functional.spec.ts\u001b[0m\r\n\u001b[2m  │ gate 6-security   pnpm -w exec playwright test -c bench/playwright.config.ts bench/security.spec.ts\u001b[0m\r\n\u001b[2m  │ log ALL true \"\" $(( $(dat"]
[29.375243, "o", "e +%s) - START ))\u001b[0m\r\n\u001b[2m  │ printf '\\n%s%s✔ all gates passed — verify.sh exit 0 (iteration %d, %ss)%s\\n' \"$BOLD\" \"$GREEN\" \"$ITER\" \"$(( $(date +%s) - START ))\" \"$R\u001b[0m\r\n"]
