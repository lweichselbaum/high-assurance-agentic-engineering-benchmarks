[24.977462, "o", "\u001b[2m  │ == entry.ts ==\u001b[0m\r\n\u001b[2m  │ // Harness entry — the only script index.html loads. Not app code.\u001b[0m\r\n\u001b[2m  │ // 1. Install the Trusted Types boundary before anything else can touch the DOM.\u001b[0m\r\n\u001b[2m  │ // 2. Start the app.\u001b[0m\r\n\u001b[2m  │ import './trusted-boundary';\u001b[0m\r\n\u001b[2m  │ import '../src/main';\u001b[0m\r\n\u001b[2m  │ == fixtures.json ==\u001b[0m\r\n\u001b[2m  │ [\u001b[0m\r\n\u001b[2m  │   {\u001b[0m\r\n\u001b[2m  │     \"id\": 1,\u001b[0m\r\n\u001b[2m  │     \"title\": \"Welcome to Porto Notes\",\u001b[0m\r\n\u001b[2m  │     \"body\": \"A shared board for the <b>OWASP AppSec Days Porto</b> crew.<br>Add a note, search, share a link.\",\u001b[0m\r\n\u001b[2m  │     \"avatar\": \"data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2040%2040%22%3\u001b[0m\r\n\u001b[2m  │     \"createdAt\": \"2026-09-01T09:00:00.000Z\"\u001b[0m\r\n\u001b[2m  │   },\u001b[0m\r\n\u001b[2m  │   {\u001b[0m\r\n\u001b[2m  │     \"id\": 2,\u001b[0m\r\n\u001b[2m  │     \"title\": \"Douro sunset\",\u001b[0m\r\n\u001b[2m  │     \"body\": \"Walk the <i>Ribeira</i> at 19:30 and cross the bridge to Gaia for the <b>Douro</b> sunset.\",\u001b[0m\r\n\u001b[2m  │     \"avatar\": \"\",\u001b[0m\r\n\u001b[2m  │     \"createdAt\": \"2026-09-01T10:15:00.000Z\"\u001b[0m\r\n\u001b[2m  │   },\u001b[0m\r\n\u001b[2m  │   {\u001b[0m\r\n\u001b[2m  │     \"id\": 3,\u001b[0m\r\n\u001b[2m  │     \"title\": \"Francesinha ranking\",\u001b[0m\r\n\u001b[2m  │ … (127 more lines)\u001b[0m\r\n"]
