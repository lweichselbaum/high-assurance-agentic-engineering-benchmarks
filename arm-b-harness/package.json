{
  "name": "arm-b-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arm B: the same feature request, built inside a high-assurance harness (strict CSP + Trusted Types + tsec + safety-web).",
  "scripts": {
    "build": "vite build --config harness/vite.config.mjs",
    "serve": "node harness/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tsec": "tsec -p tsconfig.tsec.json",
    "lint": "eslint . --max-warnings 0",
    "verify": "bash ./verify.sh"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "safevalues": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@safety-web/eslint-plugin": "0.4.1-alpha.15",
    "@types/trusted-types": "2.0.7",
    "eslint": "9.39.5",
    "tsec": "0.2.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6"
  }
}
